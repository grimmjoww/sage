{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT}/hooks/scripts/sage-session-init.sh\"",
            "commandWindows": "\"C:\\Program Files\\Git\\bin\\bash.exe\" \"${PLUGIN_ROOT}/hooks/scripts/sage-session-init.sh\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "edit|write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT}/hooks/scripts/sage-minimax-gate.sh\" sage-spec-gate.sh",
            "commandWindows": "\"C:\\Program Files\\Git\\bin\\bash.exe\" \"${PLUGIN_ROOT}/hooks/scripts/sage-minimax-gate.sh\" sage-spec-gate.sh",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT}/hooks/scripts/sage-minimax-gate.sh\" sage-tdd-gate.sh",
            "commandWindows": "\"C:\\Program Files\\Git\\bin\\bash.exe\" \"${PLUGIN_ROOT}/hooks/scripts/sage-minimax-gate.sh\" sage-tdd-gate.sh",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT}/hooks/scripts/sage-minimax-gate.sh\" sage-secrets-gate.sh",
            "commandWindows": "\"C:\\Program Files\\Git\\bin\\bash.exe\" \"${PLUGIN_ROOT}/hooks/scripts/sage-minimax-gate.sh\" sage-secrets-gate.sh",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT}/hooks/scripts/sage-minimax-gate.sh\" sage-scope-gate.sh",
            "commandWindows": "\"C:\\Program Files\\Git\\bin\\bash.exe\" \"${PLUGIN_ROOT}/hooks/scripts/sage-minimax-gate.sh\" sage-scope-gate.sh",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "edit|write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT}/hooks/scripts/sage-minimax-gate.sh\" sage-bookkeeping-gate.sh",
            "commandWindows": "\"C:\\Program Files\\Git\\bin\\bash.exe\" \"${PLUGIN_ROOT}/hooks/scripts/sage-minimax-gate.sh\" sage-bookkeeping-gate.sh",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "edit|write|bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT}/hooks/scripts/sage-minimax-gate.sh\" sage-config-gate.sh",
            "commandWindows": "\"C:\\Program Files\\Git\\bin\\bash.exe\" \"${PLUGIN_ROOT}/hooks/scripts/sage-minimax-gate.sh\" sage-config-gate.sh",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT}/hooks/scripts/sage-minimax-gate.sh\" sage-verify-gate.sh",
            "commandWindows": "\"C:\\Program Files\\Git\\bin\\bash.exe\" \"${PLUGIN_ROOT}/hooks/scripts/sage-minimax-gate.sh\" sage-verify-gate.sh",
            "timeout": 60
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "bash|write|edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT}/hooks/scripts/sage-minimax-gate.sh\" sage-verify-tracker.sh",
            "commandWindows": "\"C:\\Program Files\\Git\\bin\\bash.exe\" \"${PLUGIN_ROOT}/hooks/scripts/sage-minimax-gate.sh\" sage-verify-tracker.sh",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT}/hooks/scripts/sage-minimax-gate.sh\" sage-degradation-log.sh",
            "commandWindows": "\"C:\\Program Files\\Git\\bin\\bash.exe\" \"${PLUGIN_ROOT}/hooks/scripts/sage-minimax-gate.sh\" sage-degradation-log.sh",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT}/hooks/scripts/sage-minimax-gate.sh\" sage-manifest-sync.sh",
            "commandWindows": "\"C:\\Program Files\\Git\\bin\\bash.exe\" \"${PLUGIN_ROOT}/hooks/scripts/sage-minimax-gate.sh\" sage-manifest-sync.sh",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT}/hooks/scripts/sage-minimax-gate.sh\" sage-scope-journal.sh",
            "commandWindows": "\"C:\\Program Files\\Git\\bin\\bash.exe\" \"${PLUGIN_ROOT}/hooks/scripts/sage-minimax-gate.sh\" sage-scope-journal.sh",
            "timeout": 30
          }
        ]
      }
    ]
  }
}